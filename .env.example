# Default: Urano Desktop cyber-gateway (no tenant_channels row).
# Requires Desktop running with the plugin linked. TARGET_AGENT in Vault picks router vs a SOC agent.
AGENT_URL=http://127.0.0.1:6274/v1/webhook/mcp_cyber-gateway/default
AGENT_TIMEOUT_MS=35000

# Only if Vault INCOMING_WEBHOOK_SECRET is set:
# AGENT_TOKEN=same-as-vault-INCOMING_WEBHOOK_SECRET
# AGENT_HMAC=same-as-vault-INCOMING_WEBHOOK_SECRET

# Local rules stub instead of Desktop (demo 05):
# AGENT_URL=stub
# USE_STUB=1
# STUB_MODE=ok
# STUB_MODE=slow
# STUB_MODE=badjson
# STUB_MODE=down

# SECURITY_MODE=block_threats
# SECURITY_MODE=monitor_only
# FAIL_POLICY=open
# FAIL_POLICY=closed
# EXPOSE_DECISION=1
