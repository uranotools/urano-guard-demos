# Default (optional): Urano Desktop cyber-gateway. Not required.
# Any HTTPS that speaks schema 1.0 works — see
# https://github.com/uranotools/urano-guard/blob/main/CUSTOM_AGENT.md
# AGENT_URL=https://security.internal.example/analyze
AGENT_URL=http://127.0.0.1:6274/v1/webhook/mcp_cyber-gateway/default
AGENT_TIMEOUT_MS=35000

# Only if Vault INCOMING_WEBHOOK_SECRET is set:
# AGENT_TOKEN=same-as-vault-INCOMING_WEBHOOK_SECRET
# AGENT_HMAC=same-as-vault-INCOMING_WEBHOOK_SECRET

# Local rules stub instead of Desktop (demo 05):
# AGENT_URL=stub
# USE_STUB=1
# STUB_MODE=ok
# STUB_MODE=slow
# STUB_MODE=badjson
# STUB_MODE=down

# SECURITY_MODE=block_threats
# SECURITY_MODE=monitor_only
# FAIL_POLICY=open
# FAIL_POLICY=closed
# EXPOSE_DECISION=1
